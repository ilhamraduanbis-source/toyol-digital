# Public Firebase Web SDK configuration (not a private credential).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Real App Check site key required to send requests; do not put debug secrets here.
VITE_APP_CHECK_SITE_KEY=
# HARD DEFAULT: all false. The app NEVER enables cloud from browser checkbox alone.
VITE_ALLOW_CLOUD=false
VITE_FREE_QUOTA_VERIFIED=false
VITE_BILLING_DISABLED_CONFIRMED=false
